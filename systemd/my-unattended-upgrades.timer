[Unit]
Description=Schedule my unattended-upgrades

[Timer]
# Example: every day at 03:00.
OnCalendar=03:00

# If the machine was off at the scheduled time, run once after the next boot.
Persistent=true

# Keep the timer close to the configured calendar time.
AccuracySec=1min

[Install]
WantedBy=timers.target
